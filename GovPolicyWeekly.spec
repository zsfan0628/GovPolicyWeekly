pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="GovPolicyWeekly",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
